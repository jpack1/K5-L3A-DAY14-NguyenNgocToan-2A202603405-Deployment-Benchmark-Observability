# ============================================================
# Biến môi trường của agent. Dùng: cp .env.example .env rồi điền giá trị thật.
# KHÔNG commit .env (đã có trong .gitignore). Trên cloud, đặt các biến này ở dashboard.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security — bắt buộc khi ENVIRONMENT=production. Tạo key: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Redis (docker-compose tự đặt redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# Giới hạn
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
